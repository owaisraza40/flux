<Window x:Class="Flux.App.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flux settings" Width="850" Height="720" MinWidth="780" MinHeight="650" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
<Window.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#9A96AB"/><Setter Property="Padding" Value="13,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,2"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#F0EEF5"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#C8102E"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F0EEF5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
<Border BorderBrush="#34303E" BorderThickness="1" Padding="27"><Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid MouseLeftButtonDown="DragDialog"><StackPanel><TextBlock Text="PREFERENCES" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#C8102E"/><TextBlock Text="SET YOUR PACE." FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" IsCancel="True"/></Grid>
<TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,17,0,0">
<TabItem Header="Network"><ScrollViewer><StackPanel><TextBlock Text="CONNECTIONS &amp; RETRIES" FontSize="16" FontWeight="Bold" Margin="0,8,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="SIMULTANEOUS DOWNLOADS / 1–8" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ConcurrentBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,18,0"><TextBlock Text="CONNECTIONS / UP TO 32" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ConnectionsBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FAILED SEGMENT RETRIES / 0–10" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RetryBox"/></StackPanel></Grid><TextBlock Text="GLOBAL BANDWIDTH LIMIT / 0 = UNLIMITED" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="GlobalSpeedBox"/><ComboBox x:Name="GlobalSpeedUnit" Grid.Column="1" Margin="12,0,0,0"/></Grid><TextBlock Text="DEFAULT PER-DOWNLOAD LIMIT / 0 = UNLIMITED" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBox x:Name="SpeedBox"/><ComboBox x:Name="SpeedUnit" Grid.Column="1" Margin="12,0,0,0"/></Grid><TextBlock Text="Global and individual limits are enforced together. More connections do not guarantee higher throughput; the server and network still set the limit." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="21" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Files"><ScrollViewer><StackPanel><TextBlock Text="SAVE LOCATIONS" FontSize="16" FontWeight="Bold" Margin="0,8,0,8"/><TextBlock Text="DEFAULT DOWNLOAD DIRECTORY" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Click="Browse_Click" Margin="12,0,0,0"/><TextBox x:Name="FolderBox"/></DockPanel><TextBlock Text="WHEN A FILENAME ALREADY EXISTS" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CollisionBox"/><CheckBox x:Name="AutoSortCheck" Content="Automatically save into category directories"/><TextBlock Text="Leave a category path blank to use the default directory." Foreground="#6B6880" FontSize="10"/><TextBlock Text="VIDEO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VideoFolderBox"/><TextBlock Text="MUSIC" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MusicFolderBox"/><TextBlock Text="DOCUMENTS" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DocumentsFolderBox"/><TextBlock Text="PROGRAMS" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProgramsFolderBox"/><TextBlock Text="OTHER" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherFolderBox"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Scheduler"><StackPanel><TextBlock Text="OFF-PEAK WINDOW" FontSize="16" FontWeight="Bold" Margin="0,8,0,16"/><CheckBox x:Name="DailyCheck" Content="Run queued downloads only inside a daily time window"/><TextBlock Text="START / LOCAL 24-HOUR TIME" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DailyStartBox" Tag="22:00" IsEnabled="{Binding IsChecked,ElementName=DailyCheck}"/><TextBlock Text="STOP / LOCAL 24-HOUR TIME" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DailyStopBox" Tag="06:00" IsEnabled="{Binding IsChecked,ElementName=DailyCheck}"/><TextBlock Text="A window may cross midnight. Flux pauses scheduled activity outside the window. Per-download start/stop times are available in Add URL. Flux must be running; sleeping PCs are not woken." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="21" Margin="0,23,0,0"/></StackPanel></TabItem>
<TabItem Header="Desktop"><StackPanel><TextBlock Text="YOUR WORKSPACE" FontSize="16" FontWeight="Bold" Margin="0,8,0,16"/><CheckBox x:Name="TrayCheck" Content="Keep Flux in the system tray when minimized or closed"/><CheckBox x:Name="ClipboardCheck" Content="Watch clipboard for HTTP/HTTPS download links and offer Add URL"/><TextBlock Text="Clipboard monitoring is opt-in, reads only text locally, and never starts a download without your confirmation. It matches common file extensions and ignores repeated clipboard values." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,24"/><Border BorderBrush="#1E1E26" BorderThickness="1" Padding="18"><StackPanel><TextBlock Text="CTRL + ALT + D" FontFamily="{StaticResource MonoFont}" FontSize="16"/><TextBlock Text="Open Add URL from any app while Flux is running." Foreground="#6B6880" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></TabItem>
<TabItem Header="Browser"><StackPanel><TextBlock Text="LOCAL BROWSER BRIDGE" FontSize="16" FontWeight="Bold" Margin="0,8,0,16"/><TextBlock x:Name="BrowserStatusText" Foreground="#9A96AB" TextWrapping="Wrap" LineHeight="23"/><TextBlock Text="The optional extension pairs with your Windows account and uses a token-authenticated loopback connection at ws://localhost:6543. Each capture opens a confirmation dialog, with request cookies and referrer scoped to that URL." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="21" Margin="0,20,0,20"/><Button Content="Open browser integration" HorizontalAlignment="Left" Click="BrowserSettings_Click"/></StackPanel></TabItem>
<TabItem Header="Notifications"><ScrollViewer><StackPanel><TextBlock Text="COMPLETION &amp; SCANNING" FontSize="16" FontWeight="Bold" Margin="0,8,0,16"/><CheckBox x:Name="NotificationsCheck" Content="Show desktop tray notifications for completed downloads"/><TextBlock Text="SCANNER EXECUTABLE / BLANK = WINDOWS DEFENDER" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ScannerBox" Tag="Full path to a scanner executable"/><TextBlock Text="Scanning is enabled per download from Add URL. Completion actions (open file, play sound, run a chosen script) are also per download and default to None." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Updates"><StackPanel><TextBlock Text="STAY IN FLOW" FontSize="16" FontWeight="Bold" Margin="0,8,0,16"/><CheckBox x:Name="UpdatesCheck" Content="Check the public GitHub release on launch"/><TextBlock Text="Flux checks version metadata and notifies you. It never silently installs an executable or changes your browser security settings." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,20"/><Button Content="Check now" HorizontalAlignment="Left" Click="CheckUpdates_Click"/><TextBlock x:Name="UpdateStatusText" Foreground="#9A96AB" TextWrapping="Wrap" Margin="0,16,0,0"/><Button x:Name="OpenReleaseButton" Content="Open release" Visibility="Collapsed" Click="OpenRelease_Click" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel></TabItem>
</TabControl><StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#FF697C" TextWrapping="Wrap" Margin="0,14,0,14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,12,0"/><Button Content="SAVE SETTINGS" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="22,12"/></StackPanel></StackPanel>
</Grid></Border></Window>
