<Window x:Class="Flux.App.SettingsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Options — Flux" Width="840" Height="760" MinWidth="740" MinHeight="620" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
<Border BorderBrush="#34303E" BorderThickness="1" Padding="25"><Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid MouseLeftButtonDown="DragDialog"><StackPanel><TextBlock Text="OPTIONS" FontFamily="{StaticResource MonoFont}" Foreground="#C8102E" FontSize="9"/><TextBlock Text="MAKE IT YOURS." FontSize="25" FontWeight="Bold" Margin="0,7,0,0"/></StackPanel><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" IsCancel="True"/></Grid>
<TabControl x:Name="OptionsTabs" Grid.Row="1">
<TabItem Header="General"><ScrollViewer><StackPanel><TextBlock Text="SAVE TO FOLDER" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Click="Browse_Click" Margin="10,0,0,0"/><TextBox x:Name="FolderBox"/></DockPanel><CheckBox x:Name="AutoSortCheck" Content="Automatically sort downloads into category folders"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="SIMULTANEOUS DOWNLOADS / 1–20" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ConcurrentBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="WHEN A FILE EXISTS" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CollisionBox"/></StackPanel></Grid>
<CheckBox x:Name="StartupCheck" Content="Start Flux with Windows (this user only)"/><CheckBox x:Name="TrayCheck" Content="Minimize to tray on close"/><Expander Header="CATEGORY FOLDERS" Foreground="#9A96AB" Margin="0,14,0,0"><StackPanel><TextBlock Text="Video" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VideoFolderBox"/><TextBlock Text="Music / Audio" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MusicFolderBox"/><TextBlock Text="Compressed" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CompressedFolderBox"/><TextBlock Text="Documents" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DocumentsFolderBox"/><TextBlock Text="Programs" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProgramsFolderBox"/><TextBlock Text="Other" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OtherFolderBox"/></StackPanel></Expander>
<CheckBox x:Name="UpdatesCheck" Content="Check GitHub for updates on launch"/><WrapPanel><Button Content="Check for updates" Click="CheckUpdates_Click"/><Button x:Name="OpenReleaseButton" Content="Open release" Visibility="Collapsed" Click="OpenRelease_Click" Margin="10,0,0,0"/></WrapPanel><TextBlock x:Name="UpdateStatusText" Foreground="#9A96AB" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Connections"><ScrollViewer><StackPanel><TextBlock Text="MAX CONNECTIONS PER DOWNLOAD / 1–32" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ConnectionsBox"/><TextBlock Text="GLOBAL SPEED LIMIT / 0 = UNLIMITED" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="GlobalSpeedBox"/><ComboBox Grid.Column="1" x:Name="GlobalSpeedUnit" Margin="12,0,0,0"/></Grid><TextBlock Text="DEFAULT PER-DOWNLOAD SPEED LIMIT / 0 = UNLIMITED" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBox x:Name="SpeedBox"/><ComboBox Grid.Column="1" x:Name="SpeedUnit" Margin="12,0,0,0"/></Grid><TextBlock Text="RETRY COUNT / 0–10" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RetryBox"/><TextBlock Text="INITIAL RETRY DELAY / SECONDS" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RetryDelayBox"/><TextBlock Text="Retries back off exponentially. More connections do not guarantee more throughput; server and network limits still apply." Foreground="#6B6880" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Browser Integration"><ScrollViewer><StackPanel><TextBlock Text="BROWSER CONNECTIONS" FontSize="16" FontWeight="Bold" Margin="0,8,0,15"/><TextBlock x:Name="BrowserStatusText" Foreground="#9A96AB" TextWrapping="Wrap" LineHeight="24"/><TextBlock Text="Connected means an authenticated extension is currently communicating with Flux. Registration alone is not a connection." Foreground="#6B6880" TextWrapping="Wrap" Margin="0,12,0,14"/><Button Content="Setup instructions / extension folder" Click="BrowserSettings_Click" HorizontalAlignment="Left"/><TextBlock Text="CAPTURE FILETYPES / COMMA-SEPARATED" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CaptureTypesBox"/><TextBlock Text="DOMAIN WHITELIST / ONE PER LINE, BLANK = ALL" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WhitelistBox" Height="70" AcceptsReturn="True"/><TextBlock Text="DOMAIN BLACKLIST / ONE PER LINE" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BlacklistBox" Height="70" AcceptsReturn="True"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Media"><ScrollViewer><StackPanel><TextBlock Text="YT-DLP EXECUTABLE / BLANK = AUTO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="YtDlpPathBox" Tag="Auto-download verified official yt-dlp"/><TextBlock Text="FFMPEG EXECUTABLE / BLANK = AUTO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FfmpegPathBox"/><TextBlock Text="JAVASCRIPT RUNTIME / BLANK = AUTO" Style="{StaticResource FieldLabel}"/><TextBox x:Name="JavaScriptPathBox" Tag="Optional full path to node.exe or supported runtime"/><TextBlock Text="DEFAULT VIDEO QUALITY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="DefaultQualityBox"/><TextBlock Text="COOKIE SOURCE BROWSER" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CookieBrowserBox"/><TextBlock Text="None uses only URL-specific cookies explicitly sent with a captured link. Selecting a browser authorizes yt-dlp to read that browser's local cookies for media requests. Browser encryption or a locked profile may prevent extraction." Foreground="#9A96AB" TextWrapping="Wrap" LineHeight="21" Margin="0,16,0,0"/><TextBlock Text="First media use downloads checksum-verified tools from their official upstream releases. Flux keeps HTTPS certificate validation enabled." Foreground="#6B6880" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Scheduler"><ScrollViewer><StackPanel><CheckBox x:Name="DailyCheck" Content="Only run transfers inside this daily time window"/><TextBlock Text="START / LOCAL TIME HH:mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DailyStartBox"/><TextBlock Text="STOP / LOCAL TIME HH:mm" Style="{StaticResource FieldLabel}"/><TextBox x:Name="DailyStopBox"/><TextBlock Text="SPEED LIMIT DURING WINDOW / KB/s, 0 = GLOBAL DEFAULT" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ScheduledSpeedBox"/><TextBlock Text="An overnight window such as 23:00–07:00 is supported. Flux must be running; the scheduler does not wake a sleeping PC. Individual transfer start/stop times are available in Add URL." Foreground="#9A96AB" TextWrapping="Wrap" LineHeight="22" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Notifications"><ScrollViewer><StackPanel><CheckBox x:Name="SoundCheck" Content="Play a sound on completion"/><CheckBox x:Name="NotificationsCheck" Content="Show a Windows tray notification on completion"/><CheckBox x:Name="ClipboardCheck" Content="Monitor clipboard and prompt for download links"/><TextBlock Text="SCANNER EXECUTABLE / BLANK = WINDOWS DEFENDER" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ScannerBox"/><TextBlock Text="Scanning and open/script completion actions can be enabled per transfer. Scripts only run when explicitly selected in Add URL." Foreground="#6B6880" TextWrapping="Wrap" LineHeight="22" Margin="0,20,0,0"/></StackPanel></ScrollViewer></TabItem>
</TabControl><StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#FF697C" TextWrapping="Wrap" Margin="0,12,0,12"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,12,0"/><Button Content="SAVE SETTINGS" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="22,12"/></StackPanel></StackPanel></Grid></Border></Window>
