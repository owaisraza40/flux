<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="37"/><RowDefinition Height="75"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
<Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Content="&#xE700;" Click="ToggleSidebar_Click" ToolTip="Show / hide categories" Margin="10,0,8,0"/><TextBlock Text="FLUX / DOWNLOAD MANAGER" Foreground="#6B6880" FontFamily="{StaticResource MonoFont}" FontSize="8" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" Width="42"/><Button Style="{StaticResource IconButton}" Content="&#xE922;" ToolTip="Maximize / restore" Click="Maximize_Click" Width="42"/><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" Width="42"/></StackPanel></Grid>
<Border Grid.Row="1" BorderBrush="#1E1E26" BorderThickness="0,0,0,1"><Grid Margin="20,9,20,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource PrimaryButton}" Content="+ Add URL" Click="Add_Click" ToolTip="Ctrl+N / Insert" Margin="0,0,5,0"/><Button Content="Grab All" Click="GrabAll_Click" Margin="0,0,5,0" ToolTip="Extract URLs from clipboard / Ctrl+A"/><Button Content="Resume All" Click="ResumeAll_Click" Margin="0,0,5,0"/><Button Content="Stop All" Click="PauseAll_Click" Margin="0,0,5,0"/><Button Content="Schedule" Click="Schedule_Click" Margin="0,0,5,0"/><Button Content="Options" Click="Settings_Click"/></StackPanel><TextBox Grid.Column="1" x:Name="SearchBox" Tag="Search / Ctrl+F" TextChanged="Search_TextChanged" Margin="15,0,15,0" VerticalAlignment="Center" AutomationProperties.Name="Search downloads"/><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="TRANSFER RATE" FontSize="8" FontFamily="{StaticResource MonoFont}" Foreground="#6B6880"/><TextBlock Text="{Binding SpeedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Grid></Border>
