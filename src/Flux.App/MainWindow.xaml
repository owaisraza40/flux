<Border Grid.Row="1" Background="#111116" BorderBrush="#1E1E26" BorderThickness="1"><Grid Margin="15,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="155"/><ColumnDefinition Width="120"/><ColumnDefinition Width="75"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="65"/><ColumnDefinition Width="90"/><ColumnDefinition Width="95"/><ColumnDefinition Width="87"/></Grid.ColumnDefinitions><TextBlock Text="FILE NAME" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="1" Text="DESCRIPTION" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="2" Text="SIZE" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="3" Text="PROGRESS" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="4" Text="TRANSFER RATE" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="5" Text="TIME LEFT" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="6" Text="DATE ADDED" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="7" Text="STATUS" Style="{StaticResource ColumnLabel}"/><TextBlock Grid.Column="8" Text="ACTIONS" Style="{StaticResource ColumnLabel}"/></Grid></Border>
<Grid Grid.Row="2"><ListBox x:Name="DownloadsList" ItemsSource="{Binding RowsView}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto" MouseDoubleClick="DownloadsList_MouseDoubleClick" PreviewMouseLeftButtonDown="DownloadsList_PreviewMouseLeftButtonDown" PreviewMouseMove="DownloadsList_PreviewMouseMove" AllowDrop="True" Drop="DownloadsList_Drop"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="SelectedBorder" BorderThickness="0,0,0,1" BorderBrush="#1E1E26" Background="#0A0A0C"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedBorder" Property="Background" Value="#21121A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectedBorder" Property="Background" Value="#151219"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><Border BorderBrush="{Binding ActiveBrush}" BorderThickness="3,0,0,0" Padding="12,15,10,15"><Border.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}"><MenuItem Header="Resume" Click="ContextResume_Click" Tag="{Binding}"/><MenuItem Header="Pause" Click="ContextPause_Click" Tag="{Binding}"/><MenuItem Header="Stop and delete"><MenuItem Header="Keep downloaded file" Click="ContextRemove_Click" Tag="{Binding}"/><MenuItem Header="Delete downloaded file" Click="ContextDelete_Click" Tag="{Binding}"/></MenuItem><MenuItem Header="Restart" Click="ContextRetry_Click" Tag="{Binding}"/><Separator/><MenuItem Header="Open file" Click="ContextOpen_Click" Tag="{Binding}"/><MenuItem Header="Open folder" Click="ContextFolder_Click" Tag="{Binding}"/><MenuItem Header="Copy URL" Click="ContextCopy_Click" Tag="{Binding}"/><MenuItem Header="Properties" Click="ContextProperties_Click" Tag="{Binding}"/><Separator/><MenuItem Header="High priority" Click="Priority_Click" CommandParameter="High" Tag="{Binding}"/><MenuItem Header="Normal priority" Click="Priority_Click" CommandParameter="Normal" Tag="{Binding}"/><MenuItem Header="Low priority" Click="Priority_Click" CommandParameter="Low" Tag="{Binding}"/><Separator/><MenuItem Header="Remove from list (keep file)" Click="ContextRemove_Click" Tag="{Binding}"/></ContextMenu></Border.ContextMenu>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="155"/><ColumnDefinition Width="120"/><ColumnDefinition Width="75"/><ColumnDefinition Width="130"/><ColumnDefinition Width="90"/><ColumnDefinition Width="65"/><ColumnDefinition Width="90"/><ColumnDefinition Width="95"/><ColumnDefinition Width="87"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/><TextBlock Text="{Binding CategoryText}" Foreground="#6B6880" FontSize="9" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding SourceDomain}" ToolTip="{Binding Item.Url}" Foreground="#9A96AB" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource RowNumber}"/><StackPanel Grid.Column="3" Margin="0,0,18,0" VerticalAlignment="Center"><ProgressBar Maximum="100" local:ProgressAnimation.Value="{Binding Progress}"/><TextBlock Text="{Binding ProgressText}" FontFamily="{StaticResource MonoFont}" Foreground="#6B6880" FontSize="8" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="4" Text="{Binding SpeedText}" Style="{StaticResource RowNumber}"/><TextBlock Grid.Column="5" Text="{Binding EtaText}" Style="{StaticResource RowNumber}"/><TextBlock Grid.Column="6" Text="{Binding DateAdded}" Style="{StaticResource RowNumber}"/><StackPanel Grid.Column="7" VerticalAlignment="Center"><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8"/><TextBlock Text="{Binding PriorityLabel}" FontFamily="{StaticResource MonoFont}" Foreground="#6B6880" FontSize="7" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource IconButton}" Content="{Binding PrimaryActionGlyph}" ToolTip="{Binding PrimaryActionText}" Tag="{Binding}" Click="RowAction_Click"/><Button Style="{StaticResource IconButton}" Content="&#xE946;" ToolTip="Properties" Tag="{Binding}" Click="Properties_Click"/><Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove" Tag="{Binding}" Click="Remove_Click"/></StackPanel><TextBlock Grid.Row="1" Grid.ColumnSpan="9" Text="{Binding Error}" Foreground="#D88D99" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0" Visibility="{Binding ErrorVisibility}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470" Margin="0,-15,0,0" Visibility="Collapsed"><TextBlock Text="01 / TRANSFER CONTROL" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#C8102E" Margin="0,0,0,18"/><TextBlock x:Name="EmptyTitle" Text="READY FOR&#x0a;WHAT’S NEXT." FontSize="43" FontWeight="Bold" LineHeight="47"/><TextBlock x:Name="EmptySubtitle" Text="Add a URL. Set your pace. Take control of the transfer." Foreground="#6B6880" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,23"/><Button Style="{StaticResource PrimaryButton}" Content="+ ADD YOUR FIRST URL" Click="Add_Click" HorizontalAlignment="Left" Padding="21,12"/></StackPanel></Grid></Grid>
<ScrollViewer x:Name="BrowserPage" Grid.Row="2" Visibility="Collapsed" Margin="24"><StackPanel><TextBlock Text="BROWSER INTEGRATION" FontSize="27" FontWeight="Bold"/><TextBlock Text="Load the bundled extension, then choose Connect in its popup. Browser store listings are not published yet." Foreground="#9A96AB" TextWrapping="Wrap" Margin="0,15,0,18"/><Button Content="Open extension folder" HorizontalAlignment="Left" Click="ExtensionFolder_Click"/><TextBlock Text="CHROMIUM EXTENSION ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ExtensionIdBox"/><WrapPanel Margin="0,15,0,0"><Button Content="Register Chrome" Tag="chrome" Click="RegisterBrowser_Click" Margin="0,0,10,8"/><Button Content="Register Edge" Tag="edge" Click="RegisterBrowser_Click" Margin="0,0,10,8"/><Button Content="Register Firefox" Tag="firefox" Click="RegisterBrowser_Click" Margin="0,0,10,8"/><Button Content="Disconnect all" Click="UnregisterBrowsers_Click"/></WrapPanel><TextBlock x:Name="BrowserFeedback" Foreground="#D6A1AB" TextWrapping="Wrap" Margin="0,16,0,0"/><TextBlock x:Name="BridgeStatus" Text="WebSocket bridge: starting" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="#6B6880" Margin="0,18,0,0"/></StackPanel></ScrollViewer>
