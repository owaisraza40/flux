<Window x:Class="Flux.App.AddDownloadDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add URL — Flux" Width="730" Height="790" MinWidth="650" MinHeight="640" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize">
<Border BorderBrush="#34303E" BorderThickness="1" Padding="27"><Grid><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid MouseLeftButtonDown="DragDialog"><StackPanel><TextBlock Text="NEW TRANSFER" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="#C8102E"/><TextBlock Text="ADD A URL." FontSize="26" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel><Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" IsCancel="True"/></Grid>
<ScrollViewer Grid.Row="1" Margin="0,7,0,14"><StackPanel>
<TextBlock Text="URL / ONE PER LINE FOR A BATCH" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UrlsBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Tag="https://example.com/file.zip" AutomationProperties.Name="Download URLs"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="FILENAME / OPTIONAL" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FileNameBox" Tag="Use the server filename" AutomationProperties.Name="Filename"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CATEGORY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CategoryBox"/></StackPanel></Grid>
<TextBlock Text="SAVE TO" Style="{StaticResource FieldLabel}"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Click="Browse_Click" Margin="10,0,0,0"/><TextBox x:Name="FolderBox" AutomationProperties.Name="Download folder"/></DockPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="CONNECTIONS" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ConnectionsBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="PRIORITY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PriorityBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ENGINE" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="KindBox"/></StackPanel></Grid>
<CheckBox x:Name="SpeedCheck" Content="Limit this download's speed"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SpeedBox" Text="1024" IsEnabled="{Binding IsChecked,ElementName=SpeedCheck}"/><ComboBox x:Name="SpeedUnitBox" Grid.Column="1" Margin="12,0,0,0" IsEnabled="{Binding IsChecked,ElementName=SpeedCheck}"/></Grid>
<CheckBox x:Name="ScheduleCheck" Content="Schedule a start time" Checked="ScheduleChanged" Unchecked="ScheduleChanged"/><TextBox x:Name="StartTimeBox" IsEnabled="{Binding IsChecked,ElementName=ScheduleCheck}" Tag="yyyy-MM-dd HH:mm (local time)" AutomationProperties.Name="Scheduled start"/>
<CheckBox x:Name="StopCheck" Content="Pause at a specific time"/><TextBox x:Name="StopTimeBox" IsEnabled="{Binding IsChecked,ElementName=StopCheck}" Tag="yyyy-MM-dd HH:mm (local time)" AutomationProperties.Name="Scheduled stop"/>
<Expander Header="REQUEST DETAILS / MIRRORS" Foreground="#9A96AB" Margin="0,20,0,0"><StackPanel>
<TextBlock Text="ALTERNATE MIRRORS / ONE PER LINE, SINGLE DOWNLOAD ONLY" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MirrorsBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"/>
<TextBlock Text="REFERRER" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReferrerBox" Tag="https://example.com/page"/>
<TextBlock Text="USER-AGENT" Style="{StaticResource FieldLabel}"/><TextBox x:Name="UserAgentBox" Tag="Flux/1.0.0"/>
<TextBlock Text="COOKIES / ONLY FOR THIS URL'S ORIGIN" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CookiesBox" Height="55" AcceptsReturn="True" TextWrapping="Wrap"/>
<TextBlock Text="CUSTOM HEADERS / NAME: VALUE, ONE PER LINE" Style="{StaticResource FieldLabel}"/><TextBox x:Name="HeadersBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/><TextBlock Text="URLs, cookies and headers are retained in your private local download state. Do not share that state publicly." Foreground="#6B6880" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
</StackPanel></Expander>
<Expander Header="AFTER COMPLETION" Foreground="#9A96AB" Margin="0,20,0,12"><StackPanel><CheckBox x:Name="ScanCheck" Content="Scan the downloaded file with Windows Defender / configured scanner"/><TextBlock Text="COMPLETION ACTION" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ActionBox"/><TextBlock Text="SCRIPT / EXECUTABLE PATH (FOR RUN SCRIPT)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ScriptBox" Tag="Full path to a script you trust"/><TextBlock Text="Automatic opening and scripts are off unless you explicitly select an action here." FontSize="10" Foreground="#6B6880" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Expander>
</StackPanel></ScrollViewer>
<StackPanel Grid.Row="2"><TextBlock x:Name="ErrorText" Foreground="#FF697C" TextWrapping="Wrap" Margin="0,0,0,13"/><Grid><TextBlock Text="CTRL+ENTER TO START" FontFamily="{StaticResource MonoFont}" FontSize="8" Foreground="#6B6880" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource GhostButton}" Margin="0,0,10,0"/><Button x:Name="StartButton" Content="START DOWNLOAD" Style="{StaticResource PrimaryButton}" Click="Start_Click" Padding="20,12"/></StackPanel></Grid></StackPanel>
</Grid></Border></Window>
